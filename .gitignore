graphify-out/

# Rule-synthesis staging dirs and model caches. These hold attacker IOCs, and in the
# rerank case multi-GB model weights. Covered because an operator can point
# BLUETEAM_YARA_RULES_DIR / BLUETEAM_SIGMA_RULES_DIR / BLUETEAM_RERANK_CACHE_PATH
# inside the repo. Staged drafts must never be committed.
*_staging/
rerank-cache/
rag-cache/

# Local RAG corpus. Holds UNREDACTED analyst case notes, confirmed false-positive
# reasons and IR-playbook chunks, so it carries attacker IOCs, internal hostnames
# and victim context in one file. Written 0600 by rag_store; never commit it.
# BLUETEAM_RAG_DB is operator-configurable, so match by extension, not by name.
rag.db
rag.db-wal
rag.db-shm
*.rag.db
*.rag.db-wal
*.rag.db-shm

# OS junk
Thumbs.db

