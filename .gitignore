# Byte-compiled / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/
venv/
env/
ENV/
.venv-*/

# uv lockfile
uv.lock

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
config.env
.bak
.bak.*
.bak-*/
*.bak
*.bak.*
*.bak-*

# Logs
*.log
*.jsonl

# RapidAPI state (response cache + month-to-date budget counter). Holds attacker IPs
# and vendor verdicts, and the atomic-rewrite temp file lands beside it.
rapidapi_state.jsonl*
*.jsonl.tmp

# MCP audit log output
blue-team-mcp-audit.jsonl

# Knowledge graph output
graphify-out/

# Rule-synthesis staging dirs and model caches. These hold attacker IOCs, and in the
# rerank case multi-GB model weights. Covered because an operator can point
# BLUETEAM_YARA_RULES_DIR / BLUETEAM_SIGMA_RULES_DIR / BLUETEAM_RERANK_CACHE_PATH
# inside the repo. Staged drafts must never be committed.
*_staging/
rerank-cache/
rag-cache/

# Local RAG corpus. Holds UNREDACTED analyst case notes, confirmed false-positive
# reasons and IR-playbook chunks, so it carries attacker IOCs, internal hostnames
# and victim context in one file. Written 0600 by rag_store; never commit it.
# BLUETEAM_RAG_DB is operator-configurable, so match by extension, not by name.
rag.db
rag.db-wal
rag.db-shm
*.rag.db
*.rag.db-wal
*.rag.db-shm

# Alert-cluster store (blueteam_alert_cluster). Holds srcip entity keys, their cluster
# assignments and the fitted centroids: attacker indicators plus the shape of the
# monitored estate. Written 0600 by cluster_store; never commit it. BLUETEAM_CLUSTER_STORE
# is operator configurable, so match by extension, not by name.
clusters.db
clusters.db-wal
clusters.db-shm
*.cluster.db
*.cluster.db-wal
*.cluster.db-shm

# Vendored Laya weights (BLUETEAM_LAYA_MODEL_PATH) and the HuggingFace snapshot
# layout they are copied from. Multi-GB, and a snapshot copies the licence-gated
# original into the repo root when an operator vendors it in place.
laya-model/
laya-cache/
models--convaiinnovations--laya-multilingual/

# Evidence PDFs (blueteam_pdf_extract / blueteam_markitdown_convert /
# blueteam_document_convert and blueteam_rag_ingest(source="pdf")). Operators drop
# vendor advisories, IR reports and case exhibits under BLUETEAM_ALLOWED_PATHS, which
# can point inside the repo. Those are victim-adjacent evidence, not source: keep
# them out of history. This repo ships no PDF, so a blanket rule costs nothing.
*.pdf

# OS junk
Thumbs.db

# pytest
.pytest_cache/
.coverage
htmlcov/
*.cover

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# ruff
.ruff_cache/

# Temporary files
/tmp/
*.tmp

# STIX 2.1 egress bundles (blueteam_stix_export). BLUETEAM_EXPORT_DIR is operator-configurable
# and bundles land in a stix/ subdirectory, so an operator who points it at the repo would put
# TLP-marked attacker IOC (plus produced-by metadata) into version control. Root-anchored so it
# cannot shadow a future mcp_server/stix/ source package.
/stix/
*.stix.json
mitre_enterprise_attack.json

# PCAP captures (generated by blueteam_capture_traffic)
*.pcap
*.pcapng
capture_*.txt
